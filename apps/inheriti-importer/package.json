{
  "name": "inheriti-import",
  "productName": "Inheriti\u00ae Importer",
  "desktopName": "inheriti-importer",
  "version": "0.1.10",
  "private": true,
  "description": "Import KeePass, Passbolt, Kubernetes, Vault, and cloud secrets, review entries, and prepare them for Inheriti\u00ae Business.",
  "author": "Inheriti",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:dev": "node scripts/dev-environment.mjs dev",
    "dev:stg": "node scripts/dev-environment.mjs stg",
    "dev:prod": "node scripts/dev-environment.mjs prod",
    "dev:web": "vite",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "build": "node scripts/build-environment.mjs dev",
    "build:dev": "node scripts/build-environment.mjs dev",
    "build:stg": "node scripts/build-environment.mjs stg",
    "build:prod": "node scripts/build-environment.mjs prod",
    "release:dev": "node scripts/release-environment.mjs dev",
    "release:stg": "node scripts/release-environment.mjs stg",
    "release:prod": "node scripts/release-environment.mjs prod",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -p tsconfig.json --noEmit && node ../../scripts/verify-boundaries.mjs .",
    "package": "pnpm run release:prod",
    "release": "pnpm run lint && pnpm run package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@safetech/inheriti-core-sdk": "4.0.37",
    "@safetech/safekey-sdk": "1.0.1",
    "@tanstack/react-query": "^5.90.20",
    "fflate": "0.7.5",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "papaparse": "^5.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.7.3",
    "sonner": "^1",
    "use-context-selector": "^2.0.0",
    "yaml": "^2.9.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16",
    "@types/node": "^22.15.21",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wait-on": "^8.0.3"
  }
}
