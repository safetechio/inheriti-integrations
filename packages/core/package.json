{
  "name": "@safetech/inheriti-elements-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./node-base": {
      "types": "./dist/node-base.d.ts",
      "import": "./dist/node-base.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "import": "./dist/inbox.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && node ../../scripts/verify-boundaries.mjs .",
    "package": "pnpm run build && node ../../scripts/package-workspace.mjs"
  },
  "dependencies": {
    "@safetech/inheriti-client-sdk": "1.17.19",
    "@safetech/inheriti-core-sdk": "4.0.36",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@safetech/inheriti-elements-test-kit": "workspace:*"
  }
}
