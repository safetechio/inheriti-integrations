{
  "name": "@safetech/inheriti-cli",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "inheriti": "dist/main.js"
  },
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && node ../../scripts/verify-boundaries.mjs .",
    "package": "pnpm run build && node ../../scripts/package-cli.mjs",
    "package:dev": "pnpm run build -- --deployment=dev && node ../../scripts/package-cli.mjs --deployment=dev",
    "package:stg": "pnpm run build -- --deployment=stg && node ../../scripts/package-cli.mjs --deployment=stg",
    "package:prod": "pnpm run build -- --deployment=prod && node ../../scripts/package-cli.mjs --deployment=prod",
    "release": "pnpm run lint && pnpm run package"
  },
  "dependencies": {
    "@safetech/inheriti-core-sdk": "4.0.29",
    "@safetech/inheriti-elements-brand": "workspace:*",
    "@safetech/inheriti-elements-core": "workspace:*",
    "clipboardy": "5.3.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
