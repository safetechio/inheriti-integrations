config BR2_PACKAGE_WORKSPACE_AGENT
	bool "Inheriti® Workspace guest agent"
	depends on BR2_USE_MMU
	select BR2_PACKAGE_FEH
	select BR2_PACKAGE_XTERM
	select BR2_PACKAGE_LESS
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_LIBXML2
	depends on BR2_INSTALL_LIBSTDCPP && BR2_USE_WCHAR && BR2_TOOLCHAIN_HAS_THREADS && !BR2_STATIC_LIBS && BR2_TOOLCHAIN_GCC_AT_LEAST_7
	help
	  Open supported images, text, PDF and document files inside the
	  disposable virtual machine.
