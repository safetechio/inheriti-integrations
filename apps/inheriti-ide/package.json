{
  "name": "@safetech/inheriti-vscode-extension",
  "version": "0.0.4",
  "private": true,
  "description": "NON-PUBLISHABLE Inheriti® IDE for VS Code development build",
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "media/inheriti_avatar.png",
  "files": [
    "dist",
    "media/inheriti_avatar.png"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:inheriti.plans",
    "onCommand:inheriti.selectOrganization"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inheriti",
          "title": "Inheriti® IDE (Dev)",
          "icon": "media/inheriti_avatar.png"
        }
      ]
    },
    "views": {
      "inheriti": [
        {
          "id": "inheriti.plans",
          "name": "Plans"
        }
      ]
    },
    "commands": [
      {
        "command": "inheriti.signIn",
        "title": "Inheriti: Sign In"
      },
      {
        "command": "inheriti.signOut",
        "title": "Inheriti: Sign Out"
      },
      {
        "command": "inheriti.refresh",
        "title": "Inheriti: Refresh Plans",
        "icon": "$(refresh)"
      },
      {
        "command": "inheriti.checkUpdate",
        "title": "Inheriti: Check for Updates"
      },
      {
        "command": "inheriti.showVersion",
        "title": "Inheriti: Show Version"
      },
      {
        "command": "inheriti.selectOrganization",
        "title": "Inheriti: Select Business Organization"
      },
      {
        "command": "inheriti.openPlan",
        "title": "Inheriti: Open Plan"
      },
      {
        "command": "inheriti.revealPlan",
        "title": "Inheriti: Reveal Plan"
      },
      {
        "command": "inheriti.insertField",
        "title": "Inheriti: Insert Protected Field"
      },
      {
        "command": "inheriti.downloadAsset",
        "title": "Inheriti: Download Asset"
      },
      {
        "command": "inheriti.abortPlanAccess",
        "title": "Inheriti: Abort Plan Access"
      },
      {
        "command": "inheriti.importConfiguration",
        "title": "Inheriti: Import Configuration"
      },
      {
        "command": "inheriti.forgetMasterKey",
        "title": "Inheriti: Forget Held Key"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inheriti.refresh",
          "when": "view == inheriti.plans",
          "group": "navigation"
        },
        {
          "command": "inheriti.selectOrganization",
          "when": "view == inheriti.plans",
          "group": "navigation"
        },
        {
          "command": "inheriti.signIn",
          "when": "view == inheriti.plans",
          "group": "1_auth"
        },
        {
          "command": "inheriti.signOut",
          "when": "view == inheriti.plans",
          "group": "1_auth"
        },
        {
          "command": "inheriti.importConfiguration",
          "when": "view == inheriti.plans",
          "group": "1_auth"
        }
      ],
      "view/item/context": [
        {
          "command": "inheriti.revealPlan",
          "when": "view == inheriti.plans && viewItem == plan",
          "group": "inline"
        },
        {
          "command": "inheriti.downloadAsset",
          "when": "view == inheriti.plans && viewItem == plan",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Inheriti",
      "properties": {
        "inheriti.deployment": {
          "type": "string",
          "enum": ["", "local", "dev", "stg", "prod"],
          "default": "",
          "description": "Business deployment. Resolves API, issuer and OAuth client; leave blank for standalone configuration."
        },
        "inheriti.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Plan Access API base URL."
        },
        "inheriti.applicationId": {
          "type": "string",
          "default": "",
          "description": "Application id for standalone use. Leave blank for Business."
        },
        "inheriti.issuer": {
          "type": "string",
          "default": "",
          "description": "SafeID issuer URL."
        },
        "inheriti.clientId": {
          "type": "string",
          "default": "",
          "description": "OAuth client id registered for this VS Code host."
        },
        "inheriti.environment": {
          "type": "string",
          "enum": [
            "TEST"
          ],
          "default": "TEST",
          "description": "Development builds support TEST only."
        },
        "inheriti.masterKeySalt": {
          "type": "string",
          "default": "",
          "description": "Argon2 salt for the Master Key. The passphrase is read only from VS Code SecretStorage."
        },
        "inheriti.safeKeyProDevice": {
          "type": "string",
          "default": "",
          "description": "Local SafeKey PRO device path, for example /dev/hidraw4. Used only with a Business deployment."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-vscode-extension.mjs",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && node ../../scripts/verify-boundaries.mjs . && node ../../scripts/verify-vscode-security.mjs .",
    "package": "pnpm run build && node ../../scripts/package-vscode-extension.mjs",
    "release": "pnpm run lint && pnpm run package"
  },
  "devDependencies": {
    "@types/vscode": "1.99.1"
  },
  "dependencies": {
    "@safetech/inheriti-core-sdk": "4.0.29",
    "@safetech/inheriti-elements-brand": "workspace:*",
    "@safetech/inheriti-elements-core": "workspace:*"
  }
}
